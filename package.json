{
	"name": "text-hider",
	"version": "1.1.0",
	"description": "Visually masks Obsidian note content in the editor and Reading View to protect privacy in public.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"verify:release": "npm run build && node scripts/verify-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"lint": "eslint .",
		"test": "tsx --test test/ranges.test.ts test/settings.test.ts test/screen-tint.test.ts test/reading-image.test.ts test/release.test.ts"
	},
	"keywords": [
		"obsidian",
		"privacy",
		"editor"
	],
	"license": "ISC",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"tsx": "^4.23.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	}
}
